<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <EditText
        android:id="@+id/app_search_input"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_filter_chip"
        android:paddingHorizontal="14dp"
        android:hint="@string/search_hint"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/on_surface"
        android:textSize="13sp"
        android:fontFamily="@font/misans"
        android:singleLine="true"
        android:imeOptions="actionSearch"
        android:inputType="text" />

    <ProgressBar
        android:id="@+id/apps_loading_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginVertical="24dp"
        android:visibility="visible" />

    <TextView
        android:id="@+id/apps_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="24dp"
        android:gravity="center"
        android:text="@string/custom_package_no_apps_found"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="@font/misans"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/installed_apps_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:visibility="gone"
        android:clipToPadding="false" />

</LinearLayout>
