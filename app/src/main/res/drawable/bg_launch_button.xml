<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass primary button: tinted translucent fill + border + top sheen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/glass_primary_fill" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="13dp" android:topRightRadius="13dp" />
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/glass_highlight"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
