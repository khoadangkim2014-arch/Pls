<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass primary button: tinted translucent fill + bright rim + strong top sheen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/glass_primary_fill" />
            <stroke android:width="1.2dp" android:color="@color/glass_border" />
        </shape>
    </item>
    <item android:top="1.2dp" android:left="1.2dp" android:right="1.2dp" android:bottom="22dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="15dp" android:topRightRadius="15dp" />
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#66FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
