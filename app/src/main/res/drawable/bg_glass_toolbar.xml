<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass toolbar: translucent frosted fill, no corner rounding (edge-to-edge bar) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill_strong" />
        </shape>
    </item>
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="45dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/glass_highlight"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
