<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass floating bar: pill shape, layered translucent fill,
     bright rim highlight, soft top sheen — simulates backdrop blur via
     stacked translucent layers since true blur-behind isn't available. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- base frosted fill -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/glass_fill_strong" />
        </shape>
    </item>
    <!-- outer rim: bright glass edge -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1.2dp" android:color="@color/glass_border" />
        </shape>
    </item>
    <!-- top sheen: bright highlight along the upper edge, fading down -->
    <item android:top="1.5dp" android:left="1.5dp" android:right="1.5dp" android:bottom="34dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="26.5dp" android:topRightRadius="26.5dp" />
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#59FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- bottom inner shadow: subtle depth at the base -->
    <item android:top="34dp" android:left="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="26.5dp" android:bottomRightRadius="26.5dp" />
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#00000000"
                android:endColor="#14000000" />
        </shape>
    </item>
</layer-list>
