<?xml version="1.0" encoding="utf-8"?>
<!-- TV-flavor manifest overlay: merged on top of src/main/AndroidManifest.xml
     only for the "tv" product flavor. Adds the Leanback banner/launcher entry
     and declares this build as leanback-capable, without touching the phone
     flavor's manifest at all. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:banner="@drawable/tv_banner">

        <meta-data
            android:name="android.software.leanback"
            android:value="true" />

        <activity android:name="org.levimc.launcher.ui.activities.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
